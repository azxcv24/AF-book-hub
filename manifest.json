{
  "alphaflow_plugin": "1.0",
  "identifier": "book_hub",
  "name": "북 허브",
  "description": "전자책·실물책·오디오북을 한 곳에서 관리하고, 다른 플러그인이 신뢰할 수 있는 검증 자료로 활용할 수 있게 한다.",
  "version": "0.1.0",
  "category": "productivity",
  "author": "AlphaFlow",
  "alphaflow_min_version": "0.1.0",
  "dependencies": {
    "python": ["requests>=2.28"],
    "system": [],
    "plugins": []
  },
  "django": {
    "installed_apps": [],
    "has_models": true,
    "has_migrations": true
  },
  "env_vars": {
    "required": {},
    "optional": {
      "BOOK_HUB_NAVER_CLIENT_ID": "네이버 책 API 클라이언트 ID (ISBN 조회용)",
      "BOOK_HUB_NAVER_CLIENT_SECRET": "네이버 책 API 클라이언트 시크릿",
      "BOOK_HUB_KAKAO_REST_API_KEY": "카오 API REST 키 (ISBN 조회용)"
    }
  },
  "services": {
    "background_tasks": false,
    "scheduler": false,
    "websocket": false
  },
  "config_schema": {
    "default_currency": {
      "type": "string",
      "default": "KRW",
      "description": "구매 가격 기본 통화"
    },
    "enable_isbn_lookup": {
      "type": "boolean",
      "default": true,
      "description": "ISBN 조회로 메타데이터 자동 채우기"
    },
    "lookup_provider": {
      "type": "string",
      "default": "openlibrary",
      "enum": ["openlibrary", "naver", "kakao"],
      "description": "ISBN 메타데이터 제공자"
    }
  }
}
